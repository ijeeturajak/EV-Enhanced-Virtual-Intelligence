# =======================================================
# EV — ENHANCED VIRTUAL INTELLIGENCE CONFIGURATION
# =======================================================

# AI Provider API Keys
# Get your Google Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=

# AI Provider ('gemini', 'offline')
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview

# User Personalization
EV_USER_NAME=Sir

# Primary Voice: Microsoft Jenny Neural (Azure Speech Service)
# Leave blank to use local Windows SAPI5 voice fallback with zero Azure setup
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
VOICE_NAME=en-US-JennyNeural

# Voice Settings
WAKE_WORD=hey ev
VOICE_RATE=175
VOICE_VOLUME=1.0
VOICE_GENDER=female
LANGUAGE=en-US

# Behavior
CONTINUOUS_LISTENING=true
AUDIO_FEEDBACK=true
